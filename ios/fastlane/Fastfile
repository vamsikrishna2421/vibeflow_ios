# Build + upload VibeFlow to TestFlight from a clean CI runner, no registered
# devices and no interactive Apple login.
#
# Approach: ensure a DISTRIBUTION certificate exists (fastlane `cert`), then let
# xcodebuild do AUTOMATIC signing with `-allowProvisioningUpdates` + the App Store
# Connect API key. Xcode then self-configures each target's App ID capabilities and
# mints matching App Store provisioning profiles for all three targets (app /
# keyboard / widget) — no devices needed. (Attempt 1 failed only because there was
# NO distribution cert, so automatic signing fell back to a Development profile,
# which requires a registered device on this fresh account.)
default_platform(:ios)

TEAM_ID = "33348G2388".freeze

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false,
    )

    # Dedicated keychain for the distribution cert (CI has none by default).
    keychain_name = "vibeflow-ci.keychain"
    keychain_password = "ci-local-#{Time.now.to_i}"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    # Reuse an existing distribution certificate or create one, installed into the
    # CI keychain so automatic distribution signing has an identity to use.
    cert(
      api_key: api_key,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_password,
    )

    # gym (build_app) in this fastlane version has NO `api_key` option, so it won't
    # forward the ASC auth flags to xcodebuild on its own (attempt 4 proved passing
    # api_key here is a hard error). We inject the three authentication flags into
    # xcodebuild ourselves via xcargs/export_xcargs. Combined with
    # -allowProvisioningUpdates this lets xcodebuild reach the portal to create the
    # App Store provisioning profiles for all three targets, no registered devices.
    key_path = File.expand_path("~/asc_authkey.p8")
    File.write(key_path, ENV["ASC_KEY_P8"])
    auth = "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
           "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"

    build_app(
      workspace: "VibeFlow.xcworkspace",
      scheme: "VibeFlow",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      # Archive: automatic signing; the auth flags give -allowProvisioningUpdates the
      # portal credentials it needs to create profiles + configure capabilities.
      xcargs: "-allowProvisioningUpdates #{auth} DEVELOPMENT_TEAM=#{TEAM_ID}",
      # Export (-exportArchive) also needs the credentials to fetch/install the
      # distribution profiles; DEVELOPMENT_TEAM isn't a valid export setting here.
      export_xcargs: "-allowProvisioningUpdates #{auth}",
      export_options: {
        method: "app-store",
        teamID: TEAM_ID,
        signingStyle: "automatic",
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end
