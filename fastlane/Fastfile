# Build + upload VibeFlow to TestFlight from a clean CI runner, no registered
# devices and no interactive Apple login.
#
# Signing strategy: MANUAL, with App Store distribution provisioning profiles.
# Why not automatic: on this device-less account, automatic signing during
# `xcodebuild archive` insists on creating an iOS *Development* profile, which
# Apple refuses without a registered device ("Your team has no devices from which
# to generate a provisioning profile"). App Store *distribution* profiles need NO
# devices, so we create them explicitly (sigh, force-regenerated against the fresh
# distribution cert) and pin each of the three targets to its profile.
require "base64"

default_platform(:ios)

TEAM_ID = "33348G2388".freeze

# bundle id => Xcode target name (verified against project.pbxproj; a wrong name
# makes update_code_signing_settings a silent no-op, so keep these exact).
TARGET_FOR = {
  "com.vibeflow.dictation"          => "VibeFlow",
  "com.vibeflow.dictation.keyboard" => "VibeFlowKeyboard",
  "com.vibeflow.dictation.widget"   => "VibeFlowWidgets",
}.freeze
BUNDLES = TARGET_FOR.keys.freeze

# Explicit, known profile names (avoids parsing sigh's ENV output). Distinct from
# the pre-existing "<bundle> AppStore" profiles so force-create is unambiguous.
PROFILE_NAME = {
  "com.vibeflow.dictation"          => "VibeFlow App AppStore CI",
  "com.vibeflow.dictation.keyboard" => "VibeFlow Keyboard AppStore CI",
  "com.vibeflow.dictation.widget"   => "VibeFlow Widget AppStore CI",
}.freeze

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false,
    )

    # Dedicated keychain for the distribution cert (CI has none by default).
    keychain_name = "vibeflow-ci.keychain"
    keychain_password = "ci-local-#{Time.now.to_i}"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    # Import the STABLE distribution cert (.p12, from an encrypted GitHub secret)
    # rather than creating one each run — per-run `cert` minted a throwaway cert
    # whose key died with the runner, exhausting Apple's 2-cert cap. The p12 carries
    # the private key, so signing works and CI never mints a certificate again.
    p12_path = File.expand_path("~/vibeflow_dist.p12")
    File.open(p12_path, "wb") { |f| f.write(Base64.decode64(ENV["DIST_P12_B64"])) }
    import_certificate(
      certificate_path: p12_path,
      certificate_password: ENV["DIST_P12_PW"],
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    # Ensure the Apple WWDR G3 intermediate is in the CI keychain so codesign can
    # build the full chain (create_keychain can shadow the system keychain).
    wwdr_path = File.expand_path("~/AppleWWDRCAG3.cer")
    sh("curl -fsSL --retry 3 https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer -o #{wwdr_path}")
    begin
      import_certificate(
        certificate_path: wwdr_path,
        keychain_name: keychain_name,
        keychain_password: keychain_password,
      )
    rescue => e
      UI.message("WWDR import note (may already be present): #{e}")
    end

    # Fresh App Store profile per target, bound to the cert we just installed.
    # force: true regenerates (the pre-existing profiles went INVALID when the old
    # orphan certs were revoked), so each profile references the current cert and
    # includes the App ID's current capabilities (App Groups / Push / Sign in).
    BUNDLES.each do |bid|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bid,
        provisioning_name: PROFILE_NAME[bid],
        force: true,
        fail_on_name_taken: false,
      )
    end

    # Pin each target to manual signing + its profile + the distribution identity.
    BUNDLES.each do |bid|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ios/VibeFlow.xcodeproj",
        team_id: TEAM_ID,
        targets: [TARGET_FOR[bid]],
        code_sign_identity: "Apple Distribution",
        profile_name: PROFILE_NAME[bid],
        bundle_identifier: bid,
      )
    end

    build_app(
      workspace: "ios/VibeFlow.xcworkspace",
      scheme: "VibeFlow",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "ios/build",
      clean: true,
      export_options: {
        method: "app-store",
        teamID: TEAM_ID,
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: PROFILE_NAME,
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end
