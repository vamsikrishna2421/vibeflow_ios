<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vibeflow.keyboard" >

    <uses-sdk android:minSdkVersion="24" />

    <application>

        <!--
         The VibeFlow on-screen keyboard. Registered as an InputMethodService so it
         shows up in Settings → Languages & input → On-screen keyboard. The system
         binds it with BIND_INPUT_METHOD; the intent-filter + @xml/method make it a
         valid IME. exported=true is required for the system to bind on Android 12+.
        -->
        <service
            android:name="com.vibeflow.keyboard.VibeFlowKeyboardService"
            android:exported="true"
            android:label="VibeFlow"
            android:permission="android.permission.BIND_INPUT_METHOD" >
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>