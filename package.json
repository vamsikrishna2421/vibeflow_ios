    "patch-package": "^8.0.1",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3"
  },
  "comment:overrides": "Reproduce 1.0.52's exact Expo SDK set: everything at 57.0.1. 57.0.2/57.0.3 (2026-07-15) broke us \u2014 jsi 57.0.3 fails to COMPILE (Swift 6.2 ambiguity), and mixing versions (pinning only jsi or only core) skews JSI/core at build or runtime. All Expo deps pinned exact + core/jsi overridden so the whole native SDK is one consistent version. Remove once upstream 57.0.x fixes the jsi compile error.",
  "overrides": {
    "expo-modules-jsi": "57.0.1",
    "expo-modules-core": "57.0.1",
    "expo-modules-autolinking": "57.0.1"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js"
  },
  "private": true
}
