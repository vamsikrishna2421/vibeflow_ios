{
  "expo": {
    "name": "VibeFlow",
    "slug": "vibeflow",
    "scheme": "vibeflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0A14",
    "runtimeVersion": "3",
    "updates": {
      "url": "https://u.expo.dev/c9f0a4af-b79f-4ef5-887f-3f8a67ff31c5",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vibeflow.dictation",
      "buildNumber": "1.0.53",
      "appleTeamId": "33348G2388",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.vibeflow.dictation"
        ],
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDisplayName": "VibeFlow",
        "NSMicrophoneUsageDescription": "VibeFlow uses the microphone to turn your voice into text on-device.",
        "NSSpeechRecognitionUsageDescription": "VibeFlow uses on-device speech recognition so your voice never leaves your phone.",
        "NSPhotoLibraryUsageDescription": "VibeFlow does not access your photos. This notice is required by iOS because a bundled system component links Apple's Photos framework; no photo data is ever read or uploaded.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.vibeflow.mobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#0B0A14",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "VibeFlow uses the microphone to turn your voice into text on-device.",
          "speechRecognitionPermission": "VibeFlow uses on-device speech recognition so your voice never leaves your phone."
        }
      ],
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-notifications",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0A14",
          "image": "./assets/splash.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.vibeflow.dictation.keyboard",
                  "targetName": "VibeFlowKeyboard",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.vibeflow.dictation"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "c9f0a4af-b79f-4ef5-887f-3f8a67ff31c5"
      }
    },
    "owner": "lekkala2421"
  }
}
